# Suchna — copy to .env and fill. Never commit .env.

# ── App ──────────────────────────────────────────────────────
USE_MOCK=0
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:3000

# ── AIMLAPI (OpenAI-compatible) ──────────────────────────────
# https://docs.aimlapi.com/readme-1
AIMLAPI_KEY=
AIMLAPI_BASE_URL=https://api.aimlapi.com/v1
AIMLAPI_CHAT_MODEL=gemini-2.5-flash
AIMLAPI_GROUNDED_MODEL=gpt-4o
AIMLAPI_JUDGE_MODEL=gpt-4o-mini
AIMLAPI_EMBED_MODEL=text-embedding-3-large

# ── Bright Data ──────────────────────────────────────────────
# Web Unlocker only (NOT Tingle Scraper Studio c_* collectors).
# Zone name must match an active unlocker zone on THIS token.
# On Arjun's Tingle main account the zone is literally: cli_unlocker
# (Bright Data CLI-created unlocker). Verify with:
#   GET https://api.brightdata.com/zone/get_active_zones
BRIGHT_DATA_API_TOKEN=
BRIGHT_DATA_UNLOCKER_ZONE=cli_unlocker
# BRIGHT_DATA_UNLOCKER_TOKEN=
# BRIGHT_DATA_API_TOKEN_ALT=

# ── Speechmatics ─────────────────────────────────────────────
# Melia-1 = multilingual batch (Hinglish). Realtime Melia not GA yet
# so live mic uses Enhanced; clip upload uses Melia via /api/voice/batch.
SPEECHMATICS_API_KEY=
SPEECHMATICS_JWT_TTL_SECONDS=60
SPEECHMATICS_BATCH_MODEL=melia-1
SPEECHMATICS_REALTIME_MODEL=enhanced
SPEECHMATICS_REALTIME_LANGUAGE=en
SPEECHMATICS_LANGUAGE_HINTS=en,hi

# ── Frontend (Vite) ──────────────────────────────────────────
# Local: http://127.0.0.1:8000
# Vercel (same-origin /api via vercel.json): leave empty
VITE_API_URL=http://127.0.0.1:8000
VITE_USE_MOCK=0
