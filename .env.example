# Suchna — copy to .env and fill. Never commit .env.

# ── App ──────────────────────────────────────────────────────
USE_MOCK=0
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:3000

# ── AIMLAPI (OpenAI-compatible) ──────────────────────────────
# https://docs.aimlapi.com/readme-1
AIMLAPI_KEY=
AIMLAPI_BASE_URL=https://api.aimlapi.com/v1
AIMLAPI_CHAT_MODEL=gpt-4o-mini
AIMLAPI_EMBED_MODEL=text-embedding-3-large

# ── Bright Data ──────────────────────────────────────────────
# Reuse Web Unlocker only. Do NOT pin Tingle Scraper Studio
# collectors (TINGLE_C_*). Those are site-specific CSS extractors
# that break; Unlocker is the working Tingle path.
#
# Token: same names Tingle accepts.
BRIGHT_DATA_API_TOKEN=
# BRIGHTDATA_API_KEY=
BRIGHT_DATA_UNLOCKER_ZONE=
# Optional: if Unlocker lives on a second Bright Data account
# BRIGHT_DATA_UNLOCKER_TOKEN=

# ── Speechmatics ─────────────────────────────────────────────
# Browser Realtime SDK. Backend only mints a short-lived JWT.
SPEECHMATICS_API_KEY=
SPEECHMATICS_JWT_TTL_SECONDS=60

# ── Frontend (Vite) ──────────────────────────────────────────
VITE_API_URL=http://127.0.0.1:8000
VITE_USE_MOCK=1
